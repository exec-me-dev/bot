import re
import random
from telethon import TelegramClient, functions
from telethon.tl.types import StarsAmount

API_ID = 123456              # с my.telegram.org
API_HASH = "your_api_hash"   # с my.telegram.org
SESSION_NAME = "offer_session"

async def send_test_offer(client, user_link, gift_link, price_stars):
    # 1. Юзер
    username = user_link.split("/")[-1].replace("@", "")
    try:
        peer = await client.get_input_entity(username)
    except Exception as e:
        return f"Не смог найти юзера: {e}"

    # 2. Slug подарка из ссылки
    m = re.search(r"t\.me/nft/([A-Za-z]+)-(\d+)", gift_link)
    if not m:
        return "Ссылка на подарок неверная. Пример: https://t.me/nft/PlushPepe-123"
    slug = f"{m.group(1)}-{m.group(2)}"

    # 3. Оффер (тест — 120 секунд)
    try:
        res = await client(functions.payments.SendStarGiftOfferRequest(
            peer=peer,
            slug=slug,
            price=StarsAmount(amount=int(price_stars)),
            duration=120,
            random_id=random.getrandbits(63),
            allow_paid_stars=0,
        ))
        return f"Оффер ушёл. Ответ: {type(res).__name__}"
    except Exception as e:
        return f"Ошибка отправки: {e}"

async def main():
    client = TelegramClient(SESSION_NAME, API_ID, API_HASH)
    await client.start()   # первый раз попросит телефон и код

    result = await send_test_offer(
        client,
        user_link="t.me/someuser",
        gift_link="https://t.me/nft/PlushPepe-123",
        price_stars=100,
    )
    print(result)
    await client.disconnect()

if __name__ == "__main__":
    import asyncio
    asyncio.run(main())